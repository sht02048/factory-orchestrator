# 이 파일을 .env로 복사해 자기 환경 값으로 바꾼다. .env는 커밋하지 않는다.
# 부팅에 필요한 넷만 둔다(ADR 0005). 토큰(Linear API 키, webhook signing secret, GitHub 토큰)은
# 여기 두지 않고 온보딩에서 받아 DB에 암호화해 저장한다.
# 값은 셸 환경 변수로 읽고 packages/db의 parseBootConfig가 파싱한다. 이 파일을 자동으로 읽지는 않는다.

# web 서버 바인딩 주소와 포트. 기본값은 127.0.0.1, 3000
WEB_HOST=127.0.0.1
WEB_PORT=3000

# apps/web, apps/worker가 함께 쓰는 SQLite 파일의 절대 경로(필수)
DATABASE_PATH=/srv/factory-orchestrator/data/factory-orchestrator.db

# DB에 저장하는 토큰의 암호화 키(필수). 32바이트 base64 값을 만들어 넣는다:
#   openssl rand -base64 32
# 키를 잃거나 바꾸면 저장한 토큰을 다시 입력해야 한다.
ENCRYPTION_KEY=
