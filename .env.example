# 이 파일을 .env로 복사해 자기 환경 값으로 바꾼다. .env는 커밋하지 않는다.
# 아래 값은 모두 예시다. WEB_HOST, WEB_PORT는 apps/web 의 start 스크립트가 읽고, 나머지는 아직 읽는 코드가 없다.

# apps/web
WEB_HOST=127.0.0.1
WEB_PORT=3000
PUBLIC_BASE_URL=https://orchestrator.example.com

# apps/web, apps/worker가 함께 쓰는 SQLite 파일
DATABASE_PATH=./data/factory-orchestrator.db

# Tracker (Linear)
LINEAR_API_KEY=lin_api_example
LINEAR_WEBHOOK_SECRET=example-webhook-secret

# Pull Request 상태 조회 (GitHub)
GITHUB_TOKEN=ghp_example
