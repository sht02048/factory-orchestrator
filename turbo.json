{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../tsconfig.base.json",
        "../../scripts/build-paths.ts",
        "../../scripts/third-party.ts"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../scripts/build-paths.ts", "../../scripts/third-party.ts"],
      "outputs": ["dist/**"]
    }
  }
}
